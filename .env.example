# ---------------------------------------------------------------------------
# Skill Craft — variáveis de ambiente (copie para .env e preencha)
# NUNCA commitar o arquivo .env preenchido. Estas chaves são PÚBLICAS (anon):
# a segurança real vem das políticas de RLS do Supabase.
# ---------------------------------------------------------------------------

# Supabase Auth (Dashboard do Supabase > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contato exibido no rodapé (opcional — se vazio, os canais ficam ocultos)
# Ex.: VITE_CONTACT_EMAIL=equipe@exemplo.com
VITE_CONTACT_EMAIL=
# WhatsApp com DDI e DDD, somente dígitos. Ex.: 5511999998888
VITE_CONTACT_WHATSAPP=
# Handle do Instagram SEM arroba. Ex.: skillcraft.oficial
VITE_CONTACT_INSTAGRAM=
